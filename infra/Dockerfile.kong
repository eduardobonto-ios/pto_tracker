FROM kong:2.8.1
USER root
# The upstream hostnames are only known once the Container Apps environment
# exists, so the config is templated and rendered at start-up.
COPY infra/kong.yml.template /tmp/kong.yml.template
COPY infra/kong-entrypoint.sh /usr/local/bin/kong-entrypoint.sh
RUN chmod +x /usr/local/bin/kong-entrypoint.sh
ENV KONG_DATABASE=off \
    KONG_DECLARATIVE_CONFIG=/home/kong/kong.yml \
    KONG_PROXY_LISTEN="0.0.0.0:8000" \
    KONG_ADMIN_LISTEN="127.0.0.1:8001" \
    KONG_NGINX_WORKER_PROCESSES=1
EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/kong-entrypoint.sh"]
