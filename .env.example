# Copy this file to .env (gitignored) and fill in real values to enable
# live email sending via EmailJS — see src/lib/notifications.ts for the full
# setup walkthrough (no SMTP, no backend required).
#
# Leaving these unset keeps the app in preview-only mode: notifications are
# logged to the console and shown on the Email Notification Preview page,
# but nothing is actually emailed.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_NEW_REQUEST_TEMPLATE_ID=
VITE_EMAILJS_REVIEWED_TEMPLATE_ID=
