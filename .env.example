# Copy this file to .env (gitignored) and fill in real values.
#
# Supabase — required. Find these under Project Settings -> API in the
# Supabase dashboard. VITE_SUPABASE_ANON_KEY is the public "anon" key, safe
# to ship in the browser bundle — never put the service_role key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS — optional, enables live email sending (no SMTP, no backend
# required). See src/lib/notifications.ts for the full setup walkthrough.
# Leaving these unset keeps the app in preview-only mode: notifications are
# logged to the console and shown on the Email Notification Preview page,
# but nothing is actually emailed.

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_NEW_REQUEST_TEMPLATE_ID=
VITE_EMAILJS_REVIEWED_TEMPLATE_ID=
VITE_EMAILJS_CANCELLED_TEMPLATE_ID=
